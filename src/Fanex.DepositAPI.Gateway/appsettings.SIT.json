{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Http" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Ocelot": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AppSetting": {
    "UseErrorHandler": true,
    "Environment": "SIT",
    "Version": "1.0.0.0",
    "ApiKey": "7NqeCXBi3BXLhg1eP13kiNjsVevxaXx2"
  },
  "Sentry": {
    "Dsn": "https://ae0b39727d8b464c9ca89c9103aa438a@172.16.4.76:882/241",
    "Environment": "SIT",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true
  },
  "Ocelot": {
    "Routes": [
      {
        "UpstreamPathTemplate": "/deposit/whoami",
        "UpstreamHttpMethod": [ "GET" ],
        "Priority": 0,
        "DownstreamPathTemplate": "/whoami",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "licensee_deposit_api_SIT_1",
            "Port": 5000
          }
        ]
      },
      {
        "UpstreamPathTemplate": "/api/deposit/tickets/{id}",
        "UpstreamHttpMethod": [ "GET" ],
        "Priority": 0,
        "DownstreamPathTemplate": "/api/tickets/{id}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "licensee_deposit_api_SIT_1",
            "Port": 5000
          }
        ]
      }
    ],
    "GlobalConfiguration": {
      "BaseUrl": "https://deposit-api-gw.playonesit.com/main"
    }
  }
}
