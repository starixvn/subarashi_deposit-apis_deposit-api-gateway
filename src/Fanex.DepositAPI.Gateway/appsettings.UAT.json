{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Http" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Ocelot": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Http",
        "Args": {
          "requestUri": "http://10.2.27.8:16969",
          "queueLimitBytes": null,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AppSetting": {
    "UseErrorHandler": true,
    "Environment": "UAT",
    "Version": "2.0.0.0"
  },
  "Sentry": {
    "Dsn": "http://347954f27a2e4b24862eb088146324aa@10.99.99.51:801/254",
    "Environment": "UAT",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true
  },
  "ApiKeys": [
    {
      "Key": "deposit-api",
      "Value": "pLWQAD4OGpeKbYEMK52MXuNMfAWxn2sZ"
    },
    {
      "Key": "deposit-setting-api",
      "Value": "0sEc6qkcCnjHgBG8JFZPayX2s0pFb1sd"
    }
  ],
  "Ocelot": {
    "Routes": [
      {
        "Key": "deposit-api",
        "UpstreamPathTemplate": "/api/deposit/tickets/{id}",
        "UpstreamHttpMethod": [ "GET" ],
        "Priority": 0,
        "DownstreamPathTemplate": "/api/tickets/{id}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "licensee_deposit_api_UAT",
            "Port": 5000
          }
        ]
      },
      {
        "Key": "deposit-setting-api",
        "UpstreamPathTemplate": "/api/deposit/products/status?{everything}",
        "UpstreamHttpMethod": [ "GET" ],
        "Priority": 0,
        "DownstreamPathTemplate": "/api/products/status?{everything}",
        "DownstreamScheme": "http",
        "DownstreamHostAndPorts": [
          {
            "Host": "licensee_deposit_setting_api_UAT",
