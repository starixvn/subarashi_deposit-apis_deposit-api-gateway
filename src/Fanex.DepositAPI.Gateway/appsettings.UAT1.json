{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Http" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Ocelot": "Warning",
        "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Http",
        "Args": {
          "requestUri": "http://logstash.ops-kluat.gamora.prod:30968",
          "queueLimitBytes": null,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AppSetting": {
    "UseSwagger": true,
    "Environment": "UAT",
    "Version": "2.0.0.0"
  },
  "Sentry": {
    "Dsn": "http://347954f27a2e4b24862eb088146324aa@sentryst-ovs.ops-kluat.gamora.prod/254",
    "Environment": "UAT",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true
  },
  "ONEbook.UM": {
    "ServiceUri": "http://onebookum.starix-klprod.gamora.prod/api",
    "EnableCheckUM": true,
    "SiteId": 2000010,
    "EnableUnscheduledUM": false,
    "UMFrom": "3:00",
    "UMTo": "4:00",
    "ResultCacheDuration": 60
  },
  "ApiKeys": [
