      //  }
      //}
    ]
  },
  "AppSetting": {
    "UseErrorHandler": true,
    "Environment": "PROD",
    "Version": "2.0.0.0"
  },
  "Sentry": {
    "Dsn": "http://6fc91b41ad86490badeb8e17794276b7@10.143.8.200:9005/243",
    "Environment": "PROD",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true
  },
