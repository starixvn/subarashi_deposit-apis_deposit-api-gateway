      //    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
      //  }
      //},
      //{
      //  "Name": "Http",
      //  "Args": {
      //    "requestUri": "http://10.18.200.193:31055",
      //    "queueLimitBytes": null,
      //    "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] : {Message:lj}{NewLine}{Exception}"
      //  }
      //}
    ]
  },
  "AppSetting": {
    "UseErrorHandler": true,
    "Environment": "DEV",
    "Version": "2.0.0.0"
  },
  "Sentry": {
    "Dsn": "http://b2b3cc1d9eb1426eb091363e34086be0@sentry.nexdev.net/186",
    "Environment": "DEV",
    "MaxBreadcrumbs": 50,
    "SendDefaultPii": true
  },
  "ApiKeys": [
    {
      "Key": "deposit-api",
      "Value": "TD4ATufEKrOYjQI5YewkMiZ9T8C5pIgJ"
    },
    {
      "Key": "deposit-setting-api",
      "Value": "7Zdusjni6aQxBHyVbRrfHvv8nUfyOUvE"
    }
  ],
  "Ocelot": {
    "Routes": [
      {
        "Key": "deposit-api",
        "UpstreamPathTemplate": "/api/deposit/tickets/{id}",
        "UpstreamHttpMethod": [ "GET" ],
        "Priority": 0,
        "DownstreamPathTemplate": "/api/tickets/{id}",
        "DownstreamScheme": "https",
        "DownstreamHostAndPorts": [
          {
            "Host": "deposit-api.nexdev.net",
            "Port": 443
          }
        ]
      },
      {
        "Key": "deposit-setting-api",
        "UpstreamPathTemplate": "/api/deposit/products/status?{everything}",
        "UpstreamHttpMethod": [ "GET" ],
        "Priority": 0,
        "DownstreamPathTemplate": "/api/products/status?{everything}",
        "DownstreamScheme": "https",
        "DownstreamHostAndPorts": [
          {
            "Host": "deposit-setting-api.nexdev.net",
            "Port": 443
          }
        ]
      }
    ],
    "GlobalConfiguration": {
      "BaseUrl": "https://localhost:7083"
    }
  }
}
